AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Local: leave token unset to use data/store.json.
# Vercel: required token from a PRIVATE Blob store connected to the project.
# BLOB_READ_WRITE_TOKEN=
# Optional: use a separate path/store for Preview deployments.
# BLOB_STORE_PATH=class-deadline/store.json
# Optional GitHub OAuth, callback: /api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
